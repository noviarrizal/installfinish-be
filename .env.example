# Environment variables for InstallFinish BE. Placeholders only — never commit real values.
#
# Local development: copy to .env (git-ignored). The "local" profile imports it, so the values below work with
# compose.yaml as-is. Deployed environments: set these as platform environment variables / secrets instead.
# The active profile is chosen outside this file: SPRING_PROFILES_ACTIVE=local | prod

# --- Database ---------------------------------------------------------------------------------------------------
# Neon: jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<database>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DATABASE_URL=jdbc:postgresql://localhost:5432/installfinish
DATABASE_USERNAME=installfinish
DATABASE_PASSWORD=installfinish
# DATABASE_POOL_MAX_SIZE=5
# Optional: direct (non "-pooler") Neon endpoint for migrations when DATABASE_URL uses the pooled endpoint.
# FLYWAY_URL=

# --- Authentication (OAuth2 / OIDC bearer tokens) -----------------------------------------------------------------
# Production: issuer URI of the identity provider (its discovery document supplies the signing keys).
# JWT_ISSUER_URI=https://<identity-provider-issuer>/
JWT_AUDIENCE=installfinish-api
# JWT_STAFF_ROLES_CLAIM=installfinish_roles
# Local only: public key created by `scripts/dev-jwt.sh keys`
JWT_PUBLIC_KEY_LOCATION=file:.local/jwt/dev-public.pem

# --- Browser access -----------------------------------------------------------------------------------------------
# Comma-separated exact origins of installfinish-fe. Production origins must be https://
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- HTTP ---------------------------------------------------------------------------------------------------------
# PORT=8080
# Production only: serve /v3/api-docs to authenticated staff (Swagger UI stays off in production).
# API_DOCS_ENABLED=false

# --- Tests (optional) ---------------------------------------------------------------------------------------------
# Disposable database for integration tests on machines without Docker. Its contents WILL be modified.
# Export these in the shell that runs the tests (the test profile does not read .env).
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/installfinish_test
# TEST_DATABASE_USERNAME=
# TEST_DATABASE_PASSWORD=
